# FlightDeck Alpha environment template
#
# When deployed to Fly.io the SQLite audit database lives on a persistent
# volume mounted at /data, so the DATABASE_URL on the server is:
#   DATABASE_URL=sqlite:////data/flightdeck_alpha.db
# The default below matches the local development path; the Dockerfile sets
# the production value automatically.

# App
APP_NAME=FlightDeck Alpha
ENVIRONMENT=development
DEMO_MODE=true
LOG_LEVEL=INFO

# Alpaca paper trading
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Storage
DATABASE_URL=sqlite:///./flightdeck_alpha.db

# Risk defaults
MAX_RISK_PER_TRADE_PCT=1.5
MAX_DAILY_LOSS_PCT=3.0
MAX_DRAWDOWN_PCT=8.0
MAX_OPEN_OPTION_TRADES=5
MAX_SAME_UNDERLYING_TRADES=2
MAX_TOTAL_PREMIUM_PCT=20.0
TAKE_PROFIT_PCT=50.0
STOP_LOSS_PCT=50.0
TIME_STOP_DAYS=14
EXPIRATION_RISK_DAYS=3
MONITOR_ACTION_COOLDOWN_HOURS=24
OPTION_QUOTE_MAX_AGE_SECONDS=120
MAX_TOTAL_PREMIUM_DEPLOYED_PCT=20.0
MAX_OPTION_BID_ASK_SPREAD_PCT=15.0

# Agent configuration
# Gemini works through Google''s OpenAI-compatible endpoint.
# If using Gemini, OPENAI_API_KEY may contain the Gemini API key.
OPENAI_API_KEY=
GEMINI_API_KEY=
AGENT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AGENT_MODEL=gemini-3.7-flash

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Alpaca CLI (hackathon integration proof)
ALPACA_CLI_BINARY=alpaca

# Static SPA mount
# Production (Fly.io image): the Dockerfile copies the Vite bundle to
# /app/static and sets STATIC_DIR to that path automatically. Only set this
# when running FastAPI standalone and you want it to serve the SPA too.
# STATIC_DIR=../frontend/dist

# Built-in autonomous scheduler (runs scan + monitor cycles on a fixed
# cadence inside the deployed process). Off by default; flip to "true" once
# the final paper account is wired up.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=15
SCHEDULER_MARKET_HOURS_ONLY=true
